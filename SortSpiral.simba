{**
 * Sorts a TPointArray from a central TPoint in a spiraling manner (layer per layer).
 0 Degree is the Rightmost point of the target at Height/2  (East on a circle)
 If Start and End degrees are the same, we do a full circle check.
 Turn ClockWise ON/OFF to determine the motion of the arm
 StepSize is the width of the arm in pixels 
 Use "Circular" or "Square" to change spiraling pattern.

 *}
function TPointArray.SortSpiral(Center: TPoint; RadialSearchStartDegree, RadialSearchEndDegree: Int32 = 180; ClockWise: Boolean = True; StepSize: Int32 = 7; Shape: String = 'Circular'): TPointArray;
var
  Filtered, SortCoords: TPointArray;
  i, c, StartDeg, EndDeg, dx_orig, dy_orig: Int32;
  Angle, MidDeg, RotRad: Double;
  SinA, CosA: Double;
  IsSquare: Boolean;

  procedure GetSpiralInfo(dx, dy: Int32; out Layer, Offset: Int32);
  var
    L, RawOffset: Int32;
  begin
    if IsSquare then
    begin
      L := Abs(dx);
      if Abs(dy) > L then L := Abs(dy);

      Layer := L div StepSize;

      if L = 0 then
      begin
        Offset := 0;
        Exit;
      end;

      // Map perimeter to range -4L..4L starting from West (Clockwise)
      if (dx = -L) and (dy <= 0) then       // West to North-West
        RawOffset := -4 * L - dy
      else if (dy = -L) then                // North-West to North-East
        RawOffset := -2 * L + dx
      else if (dx = L) then                 // North-East to South-East
        RawOffset := dy
      else if (dy = L) then                 // South-East to South-West
        RawOffset := 2 * L - dx
      else                                  // South-West to West
        RawOffset := 4 * L - dy;

      // Normalize to maintain angular sorting order independent of Layer magnitude
      Offset := Round((RawOffset * 10000) / L);
    end
    else
    begin
      Layer := Round(Sqrt(dx * dx + dy * dy)) div StepSize;
      Offset := Round(ArcTan2(dy, dx) * 10000);
    end;
  end;

  procedure QuickSort(L, R: Int32);
  var
    I, J: Int32;
    PivotLayer, PivotOffset: Int32;
    L_Lay, L_Off, R_Lay, R_Off: Int32;
    Tmp: TPoint;
  begin
    I := L;
    J := R;
    GetSpiralInfo(SortCoords[(L + R) div 2].X, SortCoords[(L + R) div 2].Y, PivotLayer, PivotOffset);

    repeat
      while True do
      begin
        GetSpiralInfo(SortCoords[I].X, SortCoords[I].Y, L_Lay, L_Off);
        if (L_Lay < PivotLayer) or ((L_Lay = PivotLayer) and ((ClockWise and (L_Off < PivotOffset)) or (not ClockWise and (L_Off > PivotOffset)))) then
          Inc(I)
        else
          Break;
      end;

      while True do
      begin
        GetSpiralInfo(SortCoords[J].X, SortCoords[J].Y, R_Lay, R_Off);
        if (R_Lay > PivotLayer) or ((R_Lay = PivotLayer) and ((ClockWise and (R_Off > PivotOffset)) or (not ClockWise and (R_Off < PivotOffset)))) then
          Dec(J)
        else
          Break;
      end;

      if I <= J then
      begin
        Tmp := Self[I];
        Self[I] := Self[J];
        Self[J] := Tmp;

        Tmp := SortCoords[I];
        SortCoords[I] := SortCoords[J];
        SortCoords[J] := Tmp;

        Inc(I);
        Dec(J);
      end;
    until I > J;

    if L < J then QuickSort(L, J);
    if I < R then QuickSort(I, R);
  end;

begin
  if StepSize < 1 then StepSize := 1;
  IsSquare := (Shape = 'Square') or (Shape = 'square');

  if (RadialSearchStartDegree <> RadialSearchEndDegree) then
  begin
    SetLength(Filtered, Length(Self));
    c := 0;

    StartDeg := (RadialSearchStartDegree mod 360 + 360) mod 360;
    EndDeg := (RadialSearchEndDegree mod 360 + 360) mod 360;

    for i := 0 to High(Self) do
    begin
      Angle := ArcTan2(Self[i].Y - Center.Y, Self[i].X - Center.X) * (180.0 / Pi);
      if Angle < 0 then Angle := Angle + 360.0;

      if (StartDeg <= EndDeg) then
      begin
        if (Angle >= StartDeg) and (Angle <= EndDeg) then
        begin
          Filtered[c] := Self[i];
          Inc(c);
        end;
      end
      else
      begin
        if (Angle >= StartDeg) or (Angle <= EndDeg) then
        begin
          Filtered[c] := Self[i];
          Inc(c);
        end;
      end;
    end;
    SetLength(Filtered, c);
    Self := Filtered;
  end;

  SetLength(SortCoords, Length(Self));

  if (RadialSearchStartDegree = RadialSearchEndDegree) then
  begin
    for i := 0 to High(Self) do
    begin
      SortCoords[i].X := Self[i].X - Center.X;
      SortCoords[i].Y := Self[i].Y - Center.Y;
    end;
  end
  else
  begin
    if StartDeg > EndDeg then
      MidDeg := (StartDeg + EndDeg + 360) / 2
    else
      MidDeg := (StartDeg + EndDeg) / 2;

    RotRad := (MidDeg + 90) * (Pi / 180.0);
    CosA := Cos(RotRad);
    SinA := Sin(RotRad);

    for i := 0 to High(Self) do
    begin
      dx_orig := Self[i].X - Center.X;
      dy_orig := Self[i].Y - Center.Y;
      SortCoords[i].X := Round(dx_orig * CosA + dy_orig * SinA);
      SortCoords[i].Y := Round(-dx_orig * SinA + dy_orig * CosA);
    end;
  end;

  if (High(Self) > 0) then
    QuickSort(0, High(Self));

  Result := Self;
end;                                         